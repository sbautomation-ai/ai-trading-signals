# ---------------------------------------------------------------------------
# Frontend (Vite) — set in .env.local for dev, GitHub Secrets for CI
# ---------------------------------------------------------------------------

# Leave empty to use same-origin API (/api/*)
# Or set to your deployed backend URL (no trailing slash), e.g. https://your-app.vercel.app
VITE_API_URL=

# ---------------------------------------------------------------------------
# Backend (Vercel / Serverless) — set as Vercel environment variables
# ---------------------------------------------------------------------------

# Twelve Data API key — required for real market data (price, RSI, ATR)
# Free tier: 800 req/day, 8 req/min  →  https://twelvedata.com
TWELVE_DATA_KEY=your_twelve_data_key_here

# OpenAI API key — optional; enables GPT-written signal comments
# Without this the backend uses a template comment instead
OPENAI_API_KEY=

# OpenAI model to use for comments (default: gpt-4.1-mini)
OPENAI_MODEL=gpt-4.1-mini
